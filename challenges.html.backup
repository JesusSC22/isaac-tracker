  };

  function getWikiUrl(c) {
    return `https://bindingofisaac.es/${ES_WIKI_SLUGS[c.num]}/`;
  }

  const STORAGE_KEY = 'challenges_state';
  const CHAR_STORAGE_KEY = 'characters_state';
  const TAINTED_VISIBLE_KEY = 'tainted_visible';
  const ACTIVE_TAB_KEY = 'active_tab';

  function loadState(key = STORAGE_KEY) {
    try { return JSON.parse(localStorage.getItem(key)) || {}; }
    catch { return {}; }
  }

  function saveState(state, key = STORAGE_KEY) {
    localStorage.setItem(key, JSON.stringify(state));
  }

  function updateProgress(state) {
    const total = challenges.length;
    const done = Object.values(state).filter(Boolean).length;
    const pct = Math.round((done / total) * 100);
    document.getElementById('progressBar').style.width = pct + '%';
    document.getElementById('progressLabel').textContent = `${done} / ${total} completados (${pct}%)`;
  }

  function updateCharProgress() {
    const state = loadState(CHAR_STORAGE_KEY);
    const taintedVisible = document.getElementById('tainted-list').classList.contains('visible');
    const visible = taintedVisible ? CHARACTERS : CHARACTERS.filter(c => !c.tainted);
    let unlocked = 0, doneMarks = 0;
    const totalUnlocks = visible.length;
    const totalMarks = visible.length * COMPLETION_MARKS.length;
    visible.forEach(c => {
      if (state[`${c.slug}_unlocked`]) unlocked++;
      COMPLETION_MARKS.forEach(m => {
        if (state[`${c.slug}_mark_${m.id}`]) doneMarks++;
      });
    });
    const totalAll = totalUnlocks + totalMarks;
    const doneAll = unlocked + doneMarks;
    const pct = totalAll ? Math.round((doneAll / totalAll) * 100) : 0;
    document.getElementById('charProgressBar').style.width = pct + '%';
    document.getElementById('charProgressLabel').textContent =
      `${unlocked}/${totalUnlocks} desbloqueados · ${doneMarks}/${totalMarks} marks (${pct}%)`;
  }

  function resetAll(scope) {
    if (scope === 'challenges') {
      if (!confirm('¿Resetear el progreso de desafíos?')) return;
      saveState({}, STORAGE_KEY);
      document.querySelectorAll('#view-challenges input[type="checkbox"]').forEach(cb => {
        cb.checked = false;
        cb.closest('li').classList.remove('done');
      });
      updateProgress({});
    } else if (scope === 'characters') {
      if (!confirm('¿Resetear el progreso de personajes?')) return;
      saveState({}, CHAR_STORAGE_KEY);
      renderCharacters();
    }
  }

  const tooltipEl = document.getElementById('tooltip');

  function escapeHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function showTooltip(c, anchor) {
    const info = CHALLENGE_INFO[c.num];
    if (!info) return;
    const diffClass = DIFF_CLASS[info.dificultad] || '';
    tooltipEl.innerHTML = `
      <div class="tt-header">
        <span class="tt-title">${c.num}. ${escapeHtml(c.name)}</span>
        <span class="tt-diff ${diffClass}">${escapeHtml(info.dificultad)}</span>
      </div>
      <div class="tt-section"><span class="tt-label">Resumen:</span> ${escapeHtml(info.resumen)}</div>
      <div class="tt-section"><span class="tt-label">Cómo se desbloquea:</span> ${escapeHtml(info.desbloqueo)}</div>
      <div class="tt-section"><span class="tt-label">Recompensa:</span> ${escapeHtml(info.recompensa)}</div>
    `;
    tooltipEl.classList.add('visible');
    positionTooltip(anchor);
  }

  function positionTooltip(anchor) {
    const rect = anchor.getBoundingClientRect();
    const tt = tooltipEl.getBoundingClientRect();
    const margin = 8;
    let left = rect.right + margin;
    let top = rect.top;
    if (left + tt.width > window.innerWidth - margin) {
      left = rect.left - tt.width - margin;
    }
    if (left < margin) {
      left = margin;
      top = rect.bottom + margin;
    }
    if (top + tt.height > window.innerHeight - margin) {
      top = Math.max(margin, window.innerHeight - tt.height - margin);
    }
    tooltipEl.style.left = left + 'px';
    tooltipEl.style.top = top + 'px';
  }

  function hideTooltip() {
    tooltipEl.classList.remove('visible');
  }

  function render() {
    const state = loadState();
    const container = document.getElementById('list');

    // Group by Y (descending) — Y maps to a Tier letter (5=S best, 1=D worst)
    const TIER_LABEL = { 5: 'TIER S', 4: 'TIER A', 3: 'TIER B', 2: 'TIER C', 1: 'TIER D' };
    const groups = {};
    const groupOrder = [];
    challenges.forEach(c => {
      const key = TIER_LABEL[c.y] || `TIER ?`;
      if (!groups[key]) { groups[key] = []; groupOrder.push(key); }
      groups[key].push(c);
    });

    groupOrder.forEach(groupName => {
      const items = groups[groupName];

      const title = document.createElement('div');
      title.className = 'section-title';
      title.textContent = groupName;
      container.appendChild(title);

      const ul = document.createElement('ul');
      items.forEach(c => {
        const id = `c_${c.num}`;
        const checked = !!state[id];

        const li = document.createElement('li');
        if (checked) li.classList.add('done');

        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.id = id;
        cb.checked = checked;

        const label = document.createElement('span');
        label.className = 'label';

        const numSpan = document.createElement('span');
        numSpan.className = 'num';
        numSpan.textContent = `${c.num}.`;

        label.appendChild(numSpan);
        label.appendChild(document.createTextNode(` ${c.name}`));

        const info = CHALLENGE_INFO[c.num];
        const diffChip = document.createElement('span');
        const diffClass = info ? (DIFF_CLASS[info.dificultad] || '') : '';
        diffChip.className = `diff-chip ${diffClass}`;
        diffChip.textContent = info ? info.dificultad : '';

        const wikiLink = document.createElement('a');
        wikiLink.className = 'wiki-link';
        wikiLink.href = getWikiUrl(c);
        wikiLink.target = '_blank';
        wikiLink.rel = 'noopener noreferrer';
        wikiLink.title = `Ver ${c.name} en la wiki`;
        wikiLink.textContent = '🔗';
        wikiLink.addEventListener('click', (e) => e.stopPropagation());

        li.appendChild(cb);
        li.appendChild(label);
        li.appendChild(diffChip);
        li.appendChild(wikiLink);

        li.addEventListener('click', (e) => {
          if (e.target !== cb && e.target !== wikiLink) cb.checked = !cb.checked;
          if (e.target === wikiLink) return;
          const s = loadState();
          s[id] = cb.checked;
          saveState(s);
          li.classList.toggle('done', cb.checked);
          updateProgress(s);
        });

        li.addEventListener('mouseenter', () => showTooltip(c, li));
        li.addEventListener('mouseleave', hideTooltip);

        ul.appendChild(li);
      });
      container.appendChild(ul);
    });

    updateProgress(state);
  }

  function showCharTooltip(c, anchor) {
    const tierLabel = TIER_LABEL_CHAR[c.tier] || '';
    tooltipEl.innerHTML = `
      <div class="tt-header">
        <span class="tt-title">${escapeHtml(c.name)}</span>
        <span class="tt-diff tier-${c.tier.toLowerCase()}">${tierLabel}</span>
      </div>
      <div class="tt-section"><span class="tt-label">Cómo desbloquearlo:</span> ${escapeHtml(c.unlock)}</div>
      <div class="tt-section"><span class="tt-label">Por qué este tier:</span> ${escapeHtml(c.priority || '')}</div>
    `;
    tooltipEl.classList.add('visible');
    positionTooltip(anchor);
  }

  function renderCharacters() {
    const vanillaContainer = document.getElementById('vanilla-list');
    const taintedContainer = document.getElementById('tainted-list');
    vanillaContainer.innerHTML = '';
    taintedContainer.innerHTML = '';

    const state = loadState(CHAR_STORAGE_KEY);
    const vanilla = CHARACTERS.filter(c => !c.tainted);
    const tainted = CHARACTERS.filter(c => c.tainted);

    function renderGroup(container, list) {
      // group by tier
      const byTier = {};
      list.forEach(c => {
        (byTier[c.tier] = byTier[c.tier] || []).push(c);
      });
      TIER_ORDER.forEach(tier => {
        const chars = byTier[tier];
        if (!chars || !chars.length) return;
        const title = document.createElement('div');
        title.className = 'section-title';
        title.textContent = TIER_LABEL_CHAR[tier];
        container.appendChild(title);

        const ul = document.createElement('ul');
        chars.forEach(c => {
          const unlockKey = `${c.slug}_unlocked`;
          const isUnlocked = !!state[unlockKey];

          const li = document.createElement('li');

          const cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.checked = isUnlocked;

          const sprite = document.createElement('img');
          sprite.className = 'char-sprite';
          sprite.src = c.sprite;
          sprite.alt = c.name;

          const label = document.createElement('span');
          label.className = 'label';
          label.textContent = c.name;

          const tierChip = document.createElement('span');
          tierChip.className = `diff-chip tier-${c.tier.toLowerCase()}`;
          tierChip.style.marginLeft = 'auto';
          tierChip.textContent = `Tier ${c.tier}`;

          const marksToggle = document.createElement('button');
          marksToggle.className = 'char-marks-toggle';
          function refreshToggleText() {
            const n = COMPLETION_MARKS.filter(m => loadState(CHAR_STORAGE_KEY)[`${c.slug}_mark_${m.id}`]).length;
            const expanded = marksToggle.classList.contains('expanded');
            marksToggle.textContent = `${n}/12 ${expanded ? '▴' : '▾'}`;
          }
          refreshToggleText();

          const wikiLink = document.createElement('a');
          wikiLink.className = 'wiki-link';
          wikiLink.href = `https://bindingofisaac.es/${c.slug}/`;
          wikiLink.target = '_blank';
          wikiLink.rel = 'noopener noreferrer';
          wikiLink.title = `Ver ${c.name} en la wiki`;
          wikiLink.textContent = '🔗';
          wikiLink.addEventListener('click', (e) => e.stopPropagation());

          li.appendChild(cb);
          li.appendChild(sprite);
          li.appendChild(label);
          li.appendChild(tierChip);
          li.appendChild(marksToggle);
          li.appendChild(wikiLink);

          // marks row (sibling div, expanded on toggle)
          const marksRow = document.createElement('div');
          marksRow.className = 'marks-row';
          COMPLETION_MARKS.forEach(m => {
            const key = `${c.slug}_mark_${m.id}`;
            const dot = document.createElement('span');
            dot.className = 'mark' + (state[key] ? ' done' : '');
            dot.textContent = m.short;
            dot.title = m.name;
            dot.addEventListener('click', (e) => {
              e.stopPropagation();
              const s = loadState(CHAR_STORAGE_KEY);
              s[key] = !s[key];
              saveState(s, CHAR_STORAGE_KEY);
              dot.classList.toggle('done', s[key]);
              refreshToggleText();
              updateCharProgress();
            });
            marksRow.appendChild(dot);
          });

          marksToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const open = marksRow.classList.toggle('expanded');
            marksToggle.classList.toggle('expanded', open);
            refreshToggleText();
          });

          li.addEventListener('click', (e) => {
            if (e.target === wikiLink || e.target === marksToggle || e.target.classList.contains('mark')) return;
            if (e.target !== cb) cb.checked = !cb.checked;
            const s = loadState(CHAR_STORAGE_KEY);
            s[unlockKey] = cb.checked;
            saveState(s, CHAR_STORAGE_KEY);
            updateCharProgress();
          });

          li.addEventListener('mouseenter', () => showCharTooltip(c, li));
          li.addEventListener('mouseleave', hideTooltip);

          ul.appendChild(li);
          ul.appendChild(marksRow);
        });
        container.appendChild(ul);
      });
    }

    renderGroup(vanillaContainer, vanilla);
    renderGroup(taintedContainer, tainted);
    updateCharProgress();
  }

  // Tabs
  function switchTab(view) {
    document.querySelectorAll('.tab').forEach(t => {
      t.classList.toggle('active', t.dataset.view === view);
    });
    document.querySelectorAll('.view').forEach(v => {
      v.classList.toggle('active', v.id === `view-${view}`);
    });
    localStorage.setItem(ACTIVE_TAB_KEY, view);
    hideTooltip();
  }
  document.querySelectorAll('.tab').forEach(t => {
    t.addEventListener('click', () => switchTab(t.dataset.view));
  });

  // Tainted toggle
  const taintedBtn = document.getElementById('taintedToggle');
  const taintedList = document.getElementById('tainted-list');
  function setTaintedVisible(visible) {
    taintedList.classList.toggle('visible', visible);
    taintedBtn.textContent = visible ? '🙈 Ocultar Tainted' : '👁 Mostrar Tainted';
    localStorage.setItem(TAINTED_VISIBLE_KEY, visible ? '1' : '0');
    updateCharProgress();
  }
  taintedBtn.addEventListener('click', () => {
    setTaintedVisible(!taintedList.classList.contains('visible'));
  });

  // Init
  render();
  renderCharacters();
  setTaintedVisible(localStorage.getItem(TAINTED_VISIBLE_KEY) === '1');
  const savedTab = localStorage.getItem(ACTIVE_TAB_KEY);
  if (savedTab) switchTab(savedTab);
</script>
</body>
</html>