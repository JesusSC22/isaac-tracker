<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Challenges</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #1a1a2e;
      color: #eee;
      font-family: 'Segoe UI', sans-serif;
      padding: 30px 20px;
    }

    .container {
      max-width: 400px;
      margin: 0 auto;
    }

    h1 {
      text-align: center;
      margin-bottom: 24px;
      font-size: 1.8rem;
      color: #e94560;
      letter-spacing: 2px;
    }

    .progress-bar-container {
      background: #16213e;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 8px;
      height: 14px;
    }

    .progress-bar {
      height: 100%;
      background: #e94560;
      transition: width 0.3s ease;
      border-radius: 10px;
    }

    .progress-label {
      text-align: right;
      font-size: 0.8rem;
      color: #aaa;
      margin-bottom: 20px;
    }

    .section-title {
      font-size: 0.85rem;
      font-weight: bold;
      color: #e94560;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 20px 0 8px;
      border-bottom: 1px solid #e9456033;
      padding-bottom: 4px;
    }

    ul { list-style: none; }

    li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 12px;
      border-radius: 8px;
      transition: background 0.2s;
      cursor: pointer;
    }

    li:hover { background: #16213e; }

    li.done .label {
      text-decoration: line-through;
      color: #888;
    }

    input[type="checkbox"] {
      appearance: none;
      width: 18px;
      height: 18px;
      border: 2px solid #e94560;
      border-radius: 4px;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.2s;
      position: relative;
    }

    input[type="checkbox"]:checked { background: #e94560; }

    input[type="checkbox"]:checked::after {
      content: '✓';
      position: absolute;
      color: white;
      font-size: 12px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .label { font-size: 0.95rem; }

    .num {
      color: #aaa;
      font-size: 0.85rem;
      min-width: 26px;
    }

    .diff-chip {
      margin-left: auto;
      padding: 2px 7px;
      border-radius: 4px;
      font-weight: bold;
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
      color: white;
      flex-shrink: 0;
    }

    .diff-chip.facil       { background: #27ae60; }
    .diff-chip.medio       { background: #f39c12; }
    .diff-chip.dificil     { background: #e74c3c; }
    .diff-chip.muy-dificil { background: #8e44ad; }

    .diff-chip.tier-s { background: #ffd700; color: #1a1a2e; }
    .diff-chip.tier-a { background: #e94560; }
    .diff-chip.tier-b { background: #f39c12; }
    .diff-chip.tier-c { background: #3498db; }
    .diff-chip.tier-d { background: #7f8c8d; }

    .tt-diff.tier-s { background: #ffd700; color: #1a1a2e; }
    .tt-diff.tier-a { background: #e94560; color: white; }
    .tt-diff.tier-b { background: #f39c12; color: white; }
    .tt-diff.tier-c { background: #3498db; color: white; }
    .tt-diff.tier-d { background: #7f8c8d; color: white; }

    .wiki-link {
      color: #aaa;
      text-decoration: none;
      font-size: 0.95rem;
      padding: 2px 6px;
      border-radius: 4px;
      transition: background 0.2s, color 0.2s;
      flex-shrink: 0;
    }

    .wiki-link:hover {
      background: #e94560;
      color: white;
    }

    .challenge-tooltip {
      position: fixed;
      max-width: 340px;
      background: #0f1325;
      color: #eee;
      border: 1px solid #e94560;
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 0.78rem;
      line-height: 1.45;
      box-shadow: 0 6px 20px rgba(0,0,0,0.7);
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.15s ease;
      z-index: 1000;
    }

    .challenge-tooltip.visible {
      opacity: 1;
      visibility: visible;
    }

    .challenge-tooltip .tt-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      padding-bottom: 8px;
      border-bottom: 1px solid #ffffff15;
    }

    .challenge-tooltip .tt-title {
      font-weight: bold;
      color: #fff;
      font-size: 0.88rem;
    }

    .challenge-tooltip .tt-diff {
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: bold;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    .tt-diff.facil       { background: #27ae60; color: white; }
    .tt-diff.medio       { background: #f39c12; color: white; }
    .tt-diff.dificil     { background: #e74c3c; color: white; }
    .tt-diff.muy-dificil { background: #8e44ad; color: white; }

    .challenge-tooltip .tt-section {
      margin-top: 6px;
    }

    .challenge-tooltip .tt-label {
      color: #e94560;
      font-weight: bold;
    }

    .reset-btn {
      display: block;
      margin: 30px auto 0;
      padding: 10px 28px;
      background: transparent;
      border: 2px solid #e94560;
      color: #e94560;
      border-radius: 8px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }

    .reset-btn:hover {
      background: #e94560;
      color: white;
    }

    .tabs {
      display: flex;
      gap: 6px;
      margin-bottom: 20px;
      border-bottom: 1px solid #e9456033;
    }

    .tab {
      flex: 1;
      padding: 10px 14px;
      background: transparent;
      border: none;
      border-bottom: 3px solid transparent;
      color: #888;
      font-size: 0.95rem;
      font-weight: bold;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
    }

    .tab:hover { color: #ccc; }

    .tab.active {
      color: #e94560;
      border-bottom-color: #e94560;
    }

    .view { display: none; }
    .view.active { display: block; }

    .char-sprite {
      width: 28px;
      height: 32px;
      flex-shrink: 0;
      image-rendering: pixelated;
      object-fit: contain;
    }

    .char-marks-toggle {
      background: transparent;
      border: 1px solid #e9456055;
      color: #aaa;
      border-radius: 4px;
      padding: 2px 7px;
      font-size: 0.7rem;
      font-weight: bold;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.2s, color 0.2s;
      font-family: inherit;
    }

    .char-marks-toggle:hover {
      background: #e9456033;
      color: #fff;
    }

    .char-marks-toggle.expanded {
      background: #e94560;
      color: white;
    }

    .marks-row {
      display: none;
      padding: 6px 12px 10px 50px;
      gap: 6px;
      flex-wrap: wrap;
    }

    .marks-row.expanded { display: flex; }

    .mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #16213e;
      border: 1.5px solid #e9456055;
      color: #777;
      font-size: 0.62rem;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
      user-select: none;
    }

    .mark:hover { border-color: #e94560; }

    .mark.done {
      background: #e94560;
      color: white;
      border-color: #e94560;
    }

    .tainted-toggle {
      display: block;
      margin: 20px auto 10px;
      padding: 8px 20px;
      background: transparent;
      border: 2px dashed #8e44ad;
      color: #8e44ad;
      border-radius: 8px;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      font-family: inherit;
    }

    .tainted-toggle:hover {
      background: #8e44ad;
      color: white;
    }

    #tainted-list {
      display: none;
    }

    #tainted-list.visible { display: block; }
  </style>
</head>
<body>

<div class="container">
  <h1>🎮 Isaac Tracker</h1>

  <div class="tabs">
    <button class="tab active" data-view="challenges">Desafíos</button>
    <button class="tab" data-view="characters">Personajes</button>
  </div>

  <div class="view active" id="view-challenges">
    <div class="progress-bar-container">
      <div class="progress-bar" id="progressBar"></div>
    </div>
    <div class="progress-label" id="progressLabel"></div>

    <div id="list"></div>

    <button class="reset-btn" onclick="resetAll('challenges')">Resetear desafíos</button>
  </div>

  <div class="view" id="view-characters">
    <div class="progress-bar-container">
      <div class="progress-bar" id="charProgressBar"></div>
    </div>
    <div class="progress-label" id="charProgressLabel"></div>

    <div id="vanilla-list"></div>

    <button class="tainted-toggle" id="taintedToggle">👁 Mostrar Tainted</button>

    <div id="tainted-list"></div>

    <button class="reset-btn" onclick="resetAll('characters')">Resetear personajes</button>
  </div>
</div>

<div class="challenge-tooltip" id="tooltip"></div>

<script>
  const CHARACTERS = [
    {
      slug: "isaac",
      name: "Isaac",
      tainted: false,
      tier: "S",
      unlock: "Disponible desde el inicio del juego.",
      priority: "Personaje base y el más fácil de completar; sus marks desbloquean items fundamentales (Polaroid, D6 variants, Glitched Crown vía Tainted Isaac) e introducen el resto del juego.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "cain",
      name: "Cain",
      tainted: false,
      tier: "S",
      unlock: "Tener 55 monedas en una sola partida.",
      priority: "Buenas estadísticas base y suerte; al completarlo desbloqueas Money = Power, Bum Friend y Sack of Pennies — items que sinergizan con casi todas las builds.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "apollyon",
      name: "Apollyon",
      tainted: false,
      tier: "S",
      unlock: "Derrotar a Ultra Greed en modo Greed.",
      priority: "Sus completions desbloquean Void (item activo top 3 del juego, absorbe pasivos como stats y activos como cargas). También Birthright muy útil. Cada completion suma synergies — máxima prioridad.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "magdalene",
      name: "Magdalene",
      tainted: false,
      tier: "A",
      unlock: "Tener 7 contenedores de vida roja en una sola partida.",
      priority: "Vida base alta = fácil de completar. Sus completions desbloquean Sigil of Baphomet (uno de los mejores trinkets defensivos: angel deals garantizados), Yum Heart y Maggy's Faith.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "lazarus",
      name: "Lazarus",
      tainted: false,
      tier: "A",
      unlock: "Hacer un Devil Deal con 2 corazones rojos llenos en una sola partida.",
      priority: "Dos vidas = casi imposible morir, así que es de los más cómodos de completar. Desbloquea Anemic (anti-bullet brutal), Lazarus's Rags (revive con stats) y es prerequisito para Bethany.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "bethany",
      name: "Bethany",
      tainted: false,
      tier: "A",
      unlock: "Derrotar a Hush con Lazarus.",
      priority: "Mecánica única (soul hearts como mana). Sus completions desbloquean Hallowed Ground (spawnea Angel Rooms cada piso — broken), Wisps poderosos via Book of Virtues, y todo el set de Tainted Bethany.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "eden",
      name: "Eden",
      tainted: false,
      tier: "A",
      unlock: "Derrotar a Mom's Heart con cualquier personaje.",
      priority: "Cada completion acumula Eden Tokens (canjeables por runs garantizadas de Eden) y desbloquea Eden's Soul (active que spawnea items). Cada run empieza con 2 items aleatorios — partidas únicas y entretenidas cada vez.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "judas",
      name: "Judas",
      tainted: false,
      tier: "B",
      unlock: "Derrotar a Satan.",
      priority: "Damage alto base + Book of Belial inicial. Sus completions desbloquean Judas's Shadow (revive como Dark Judas con +1 damage), Book of the Dead y Eucharist — útiles pero no game-changing.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "blue-baby",
      name: "??? (Blue Baby)",
      tainted: false,
      tier: "B",
      unlock: "Destruir una urna del Útero/Womb (drop random).",
      priority: "Vida solo en soul hearts. Sus completions desbloquean items como Suicide King, Lost Contact, The Polaroid (acceso a The Chest) y Birthright para él.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "eve",
      name: "Eve",
      tainted: false,
      tier: "B",
