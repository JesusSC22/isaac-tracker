    {
      slug: "tainted-magdalena",
      name: "Tainted Magdalene",
      tainted: true,
      tier: "A",
      unlock: "Completar el ritual del cuchillo jugando como Magdalene.",
      priority: "Sistema de hearts único (8 contenedores que se descargan). Accesible para empezar tainted; completions valiosas para builds de vida.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "tainted-bethany",
      name: "Tainted Bethany",
      tainted: true,
      tier: "A",
      unlock: "Completar el ritual del cuchillo jugando como Bethany.",
      priority: "Wisps personalizados a items. Sus completions desbloquean items de book/wisp top tier.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "tainted-apollyon",
      name: "Tainted Apollyon",
