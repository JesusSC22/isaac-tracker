    {
      slug: "tainted-the-lost",
      name: "Tainted Lost",
      tainted: true,
      tier: "D",
      unlock: "Completar el ritual del cuchillo jugando como The Lost (extremadamente difícil).",
      priority: "Como The Lost pero peor — sin Holy Mantle de inicio. Solo para masocistas o por trofeo de completismo absoluto.",
