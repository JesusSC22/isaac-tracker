    {
      slug: "jacob-and-esau",
      name: "Jacob & Esau",
      tainted: false,
      tier: "C",
      unlock: "Derrotar a Mom's Heart con Magdalene.",
      priority: "Dos personajes simultáneos — curiosidad mecánica. Sus completions desbloquean Mom's Bracelet y otros items menores; bajo retorno por el esfuerzo.",
      sprite: "data:image/png;base64,",
    },
    {
      slug: "the-lost",
